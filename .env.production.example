# ==========================================
# PIYELLA LUXURY E-COMMERCE - PRODUCTION ENV
# ==========================================

# Base Application URL
NEXT_PUBLIC_APP_URL="https://piyella.com"
NODE_ENV="production"

# Clerk Authentication (v7)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/account"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/account"
CLERK_WEBHOOK_SECRET="whsec_..."

# PostgreSQL & Supabase Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Razorpay Payment Gateway (Live Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="secret_live_..."
RAZORPAY_WEBHOOK_SECRET="whsec_razorpay_live_..."

# Shiprocket Logistics API
SHIPROCKET_EMAIL="logistics@piyella.com"
SHIPROCKET_PASSWORD="Production_Password_123"

# Cloudinary Media Assets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="piyella-atelier"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="Cloudinary_Secret_Key"

# Error Monitoring & Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="prj_analytics_..."
NEXT_PUBLIC_SENTRY_DSN="https://key@sentry.io/1234567"
